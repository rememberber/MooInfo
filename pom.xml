<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.luoboduner.moo.info</groupId>
    <artifactId>MooInfo</artifactId>
    <version>1.1.5</version>
    <packaging>jar</packaging>

    <name>MooInfo</name>
    <url>http://www.luoboduner.com</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <logback.version>1.6.0</logback.version>
        <forms_rt.version>7.0.3</forms_rt.version>
        <lombok.version>1.18.46</lombok.version>
        <junit-jupiter-api.version>6.1.2</junit-jupiter-api.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <guava.version>33.6.0-jre</guava.version>
        <okhttp.version>5.4.0</okhttp.version>
        <flatlaf.version>3.7.2</flatlaf.version>
        <flatlaf-extras.version>3.7.2</flatlaf-extras.version>
        <flatlaf-intellij-themes.version>3.7.2</flatlaf-intellij-themes.version>
        <hutool-all.version>5.8.47</hutool-all.version>
        <fastjson.version>2.0.62</fastjson.version>
        <oshi-core.version>7.4.2</oshi-core.version>
        <jfreechart.version>1.5.6</jfreechart.version>
        <imaging.version>1.0.0-alpha6</imaging.version>
        <xmlwise.version>1.2.11</xmlwise.version>
        <javapackager.version>1.7.6</javapackager.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>

        <packaging.outputDirectory>${project.build.directory}</packaging.outputDirectory>
        <packaging.jdkPath>${java.home}</packaging.jdkPath>
        <packaging.javaBinary>${java.home}/bin/java</packaging.javaBinary>
        <packaging.requireRepoJdk>false</packaging.requireRepoJdk>
        <packaging.targetId>local</packaging.targetId>
        <packaging.mac.startup>UNIVERSAL</packaging.mac.startup>
    </properties>

    <profiles>
        <profile>
            <id>mac-universal</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <packaging.outputDirectory>${project.build.directory}</packaging.outputDirectory>
                <packaging.jdkPath>${java.home}</packaging.jdkPath>
                <packaging.javaBinary>${java.home}/bin/java</packaging.javaBinary>
                <packaging.requireRepoJdk>false</packaging.requireRepoJdk>
                <packaging.targetId>mac-universal</packaging.targetId>
                <packaging.mac.startup>UNIVERSAL</packaging.mac.startup>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.fvarrui</groupId>
                        <artifactId>javapackager</artifactId>
                        <executions>
                            <execution>
                                <id>bundling-for-mac-universal</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>package</goal>
                                </goals>
                                <configuration>
                                    <platform>mac</platform>
                                    <createTarball>true</createTarball>
                                    <macConfig>
                                        <macStartup>${packaging.mac.startup}</macStartup>
                                    </macConfig>
                                    <additionalModules>jdk.crypto.ec</additionalModules>
                                    <additionalResources>
                                        <additionalResource>${name}.l4j.ini</additionalResource>
                                    </additionalResources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mac-intel</id>
            <properties>
                <packaging.outputDirectory>${project.build.directory}/mac-intel</packaging.outputDirectory>
                <packaging.mac.startup>X86_64</packaging.mac.startup>
                <packaging.jdkPath>${project.basedir}/jdks/mac/x64/home</packaging.jdkPath>
                <packaging.javaBinary>${project.basedir}/jdks/mac/x64/home/bin/java</packaging.javaBinary>
                <packaging.requireRepoJdk>true</packaging.requireRepoJdk>
                <packaging.targetId>mac-intel</packaging.targetId>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.fvarrui</groupId>
                        <artifactId>javapackager</artifactId>
                        <executions>
                            <execution>
                                <id>bundling-for-mac-intel</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>package</goal>
                                </goals>
                                <configuration>
                                    <platform>mac</platform>
                                    <createTarball>true</createTarball>
                                    <macConfig>
                                        <macStartup>${packaging.mac.startup}</macStartup>
                                    </macConfig>
                                    <additionalModules>jdk.crypto.ec</additionalModules>
                                    <additionalResources>
                                        <additionalResource>${name}.l4j.ini</additionalResource>
                                    </additionalResources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mac-apple-silicon</id>
            <properties>
                <packaging.outputDirectory>${project.build.directory}/mac-apple-silicon</packaging.outputDirectory>
                <packaging.mac.startup>ARM64</packaging.mac.startup>
                <packaging.jdkPath>${project.basedir}/jdks/mac/arm64/home</packaging.jdkPath>
                <packaging.javaBinary>${project.basedir}/jdks/mac/arm64/home/bin/java</packaging.javaBinary>
                <packaging.requireRepoJdk>true</packaging.requireRepoJdk>
                <packaging.targetId>mac-apple-silicon</packaging.targetId>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.fvarrui</groupId>
                        <artifactId>javapackager</artifactId>
                        <executions>
                            <execution>
                                <id>bundling-for-mac-apple-silicon</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>package</goal>
                                </goals>
                                <configuration>
                                    <platform>mac</platform>
                                    <createTarball>true</createTarball>
                                    <macConfig>
                                        <macStartup>${packaging.mac.startup}</macStartup>
                                    </macConfig>
                                    <additionalModules>jdk.crypto.ec</additionalModules>
                                    <additionalResources>
                                        <additionalResource>${name}.l4j.ini</additionalResource>
                                    </additionalResources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>windows-x64</id>
            <properties>
                <packaging.outputDirectory>${project.build.directory}/windows-x64</packaging.outputDirectory>
                <packaging.jdkPath>${project.basedir}/jdks/windows/x64/home</packaging.jdkPath>
                <packaging.javaBinary>${project.basedir}/jdks/windows/x64/home/bin/java.exe</packaging.javaBinary>
                <packaging.requireRepoJdk>true</packaging.requireRepoJdk>
                <packaging.targetId>windows-x64</packaging.targetId>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.fvarrui</groupId>
                        <artifactId>javapackager</artifactId>
                        <executions>
                            <execution>
                                <id>bundling-for-windows-x64</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>package</goal>
                                </goals>
                                <configuration>
                                    <platform>windows</platform>
                                    <createZipball>true</createZipball>
                                    <additionalModules>jdk.crypto.ec</additionalModules>
                                    <additionalResources>
                                        <additionalResource>${name}.l4j.ini</additionalResource>
                                    </additionalResources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>linux-x64</id>
            <properties>
                <packaging.outputDirectory>${project.build.directory}/linux-x64</packaging.outputDirectory>
                <packaging.jdkPath>${project.basedir}/jdks/linux/x64/home</packaging.jdkPath>
                <packaging.javaBinary>${project.basedir}/jdks/linux/x64/home/bin/java</packaging.javaBinary>
                <packaging.requireRepoJdk>true</packaging.requireRepoJdk>
                <packaging.targetId>linux-x64</packaging.targetId>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.fvarrui</groupId>
                        <artifactId>javapackager</artifactId>
                        <executions>
                            <execution>
                                <id>bundling-for-linux-x64</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>package</goal>
                                </goals>
                                <configuration>
                                    <platform>linux</platform>
                                    <createTarball>true</createTarball>
                                    <additionalModules>jdk.crypto.ec</additionalModules>
                                    <additionalResources>
                                        <additionalResource>${name}.l4j.ini</additionalResource>
                                    </additionalResources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit-jupiter-api.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!--GUI Designer -> binary class files-->
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>forms_rt</artifactId>
            <version>${forms_rt.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>

        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
            <version>${flatlaf-extras.version}</version>
        </dependency>

        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-intellij-themes</artifactId>
            <version>${flatlaf-intellij-themes.version}</version>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool-all.version}</version>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>${fastjson.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>${oshi-core.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>${jfreechart.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-imaging</artifactId>
            <version>${imaging.version}</version>
        </dependency>

        <dependency>
            <groupId>xmlwise</groupId>
            <artifactId>xmlwise</artifactId>
            <version>${xmlwise.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-packaging-jdk</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <condition property="packaging.jdk.ready">
                                    <or>
                                        <not>
                                            <istrue value="${packaging.requireRepoJdk}"/>
                                        </not>
                                        <available file="${packaging.javaBinary}"/>
                                    </or>
                                </condition>
                                <fail unless="packaging.jdk.ready"
                                      message="Missing repository-local JDK for profile '${packaging.targetId}'. Expected executable: ${packaging.javaBinary}. Run 'python3 scripts/prepare_jdks.py --targets ${packaging.targetId}' before packaging."/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.fvarrui</groupId>
                <artifactId>javapackager</artifactId>
                <version>${javapackager.version}</version>
                <configuration>
                    <outputDirectory>${packaging.outputDirectory}</outputDirectory>
                    <displayName>${project.name}</displayName>
                    <bundleJre>true</bundleJre>
                    <jdkPath>${packaging.jdkPath}</jdkPath>
                    <mainClass>com.luoboduner.moo.info.App</mainClass>
                    <generateInstaller>true</generateInstaller>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
